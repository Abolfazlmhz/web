/*
Vazir Font Family (Vazirmatn) - Persian/Farsi Font
https://github.com/rastikerdar/vazirmatn
*/

/* Vazirmatn Thin */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 100;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-Thin.woff2") format("woff2");
}

/* Vazirmatn ExtraLight */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 200;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-ExtraLight.woff2") format("woff2");
}

/* Vazirmatn Light */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 300;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-Light.woff2") format("woff2");
}

/* Vazirmatn Regular */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 400;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-Regular.woff2") format("woff2");
}

/* Vazirmatn Medium */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 500;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-Medium.woff2") format("woff2");
}

/* Vazirmatn SemiBold */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 600;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-SemiBold.woff2") format("woff2");
}

/* Vazirmatn Bold */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 700;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-Bold.woff2") format("woff2");
}

/* Vazirmatn ExtraBold */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 800;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-ExtraBold.woff2") format("woff2");
}

/* Vazirmatn Black */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 900;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn-Black.woff2") format("woff2");
}

/* Vazirmatn Variable Font */
@font-face {
    font-family: "Vazirmatn";
    font-weight: 100 900;
    font-style: normal;
    src: url("$(res)/fonts/vazir/Vazirmatn[wght].woff2") format("woff2");
}

/* Define @vazir CSS variable for Vazirmatn font family */
@vazir: "Vazirmatn", sans-serif;
