.mx_MobileBottomNav {
    display: none;
}

@media only screen and (max-width: 768px) {
    .mx_MobileBottomNav {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-around;
        width: 100%;
        height: 56px;
        background-color: $background;
        border-top: 1px solid $separator;
        padding: 4px 0;
        flex-shrink: 0;
        z-index: 10;
    }

    .mx_MobileBottomNav_tab {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        flex: 1;
        border: none;
        background: none;
        cursor: pointer;
        padding: 4px 0;
        color: $secondary-content;
        -webkit-tap-highlight-color: transparent;

        &.active {
            color: $accent;

            .mx_MobileBottomNav_icon {
                background-color: $accent;
            }
        }

        &:hover:not(.active) {
            color: $primary-content;

            .mx_MobileBottomNav_icon {
                background-color: $primary-content;
            }
        }
    }

    .mx_MobileBottomNav_icon {
        width: 24px;
        height: 24px;
        mask-position: center;
        mask-repeat: no-repeat;
        mask-size: 24px;
        background-color: $secondary-content;
    }

    .mx_MobileBottomNav_icon_chat {
        mask-image: url("@vector-im/compound-design-tokens/icons/chat-solid.svg");
    }

    .mx_MobileBottomNav_icon_agriculture {
        mask-image: url("$(res)/img/element-icons/agriculture.svg");
    }

    .mx_MobileBottomNav_icon_services {
        mask-image: url("$(res)/img/element-icons/services.svg");
    }

    .mx_MobileBottomNav_icon_more {
        mask-image: url("@vector-im/compound-design-tokens/icons/overflow-horizontal.svg");
    }

    .mx_MobileBottomNav_label {
        font-size: 10px;
        line-height: 14px;
        font-weight: 500;
        white-space: nowrap;
    }
}
